# Rust build artefacts. A debug build is ~4 GiB, most of it the staticlib Tauri
# needs for iOS.
target/

# Tauri capability schemas, generated by tauri-build on every compile
src-tauri/gen/

# Screen-render output — regenerate with `node tests/screens.mjs out/`
screens-out/

# cargo-mutants working tree and reports. The kill rate belongs in a Gate
# Evidence Record; the per-mutant logs are a rerun away and are ~100 MB.
#
# Note for anyone rerunning it here: this workspace has sibling path
# dependencies (`../did-crdt`, `../cbcl-rs`), which cargo-mutants' default
# copy-to-tmp strategy breaks. Use `--in-place`, from a clean tree.
mutants.out/
mutants.out.old/

node_modules/
.DS_Store
**/.DS_Store

# zetl builds this index from the vault on every `zetl check`. It is a cache,
# not source, and it churns by ~2000 lines whenever a spec is touched.
specs/.zetl/
