;; Propagation rules: failures in 'screens' block downstream tasks
(normally r-propagate-docs-from-screens-failed failed-screens upstream-blocked-docs)
(normally r-propagate-docs-from-screens-permanently-failed permanently-failed-screens upstream-blocked-docs)
(normally r-propagate-docs-from-screens-stale-v1 stale-v1-screens upstream-blocked-docs)
(normally r-propagate-docs-from-screens-timeout-v1 timeout-v1-screens upstream-blocked-docs)

